{
	"name": "mu-desktop",
	"version": "0.1.8",
	"description": "mu's desktop shell: a small Electron app that starts the mu harness and draws the conversation it streams",
	"private": true,
	"license": "Apache-2.0",
	"author": "the mu authors",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
		"test": "vitest --run",
		"test:e2e": "playwright test test/e2e",
		"budget": "node ../scripts/desktop-budget.mjs --check",
		"budget:update": "node ../scripts/desktop-budget.mjs --update",
		"package": "electron-builder --publish never",
		"smoke:package": "node scripts/smoke-package.mjs",
		"install:rehearsal": "node scripts/install-rehearsal.mjs",
		"startup": "node scripts/startup.mjs",
		"metrics": "node scripts/collect-metrics.mjs",
		"render-probes": "node scripts/render-probes.mjs",
		"startup:update": "node scripts/startup.mjs --update"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "file:../packages/coding-agent",
		"@playwright/test": "1.64.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "44.9.0",
		"electron-builder": "26.15.3",
		"electron-vite": "6.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
