# The user-level npmrc on this machine sets omit=optional. That breaks the shell's build
# toolchain: vite 8 resolves its bundler through rolldown, and rolldown, lightningcss and
# electron all ship their platform binaries as optional dependencies. Without them vite
# cannot even load a TypeScript config file (the JS wrapper finds no matching native
# binding and the neighbouring checkout's one fails the napi version handshake).
include=optional

# Installs stay offline-ish and side-effect free by default; hydrate with
# `npm install --ignore-scripts`. The one script we do run on purpose is electron's own
# binary download: `npm rebuild electron`.
save-exact=true
