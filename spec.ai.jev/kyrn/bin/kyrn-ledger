#!/usr/bin/env node
// Review what the judge said about your real messages.
//
//   kyrn/bin/kyrn-ledger              decisions from the 5 most recent mu sessions
//   kyrn/bin/kyrn-ledger 20           ... from the 20 most recent
//   kyrn/bin/kyrn-ledger --json       one JSON object per decision, for scripts
//
// Reads the `kyrn.decision` entries the kernel appends to pi session files and
// pairs each with the user message it judged. Nothing is sent anywhere.
import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);

// The cost view needs the model catalog, so it lives in the kernel's own entry (packages/kyrn-judge/src/ledger/cli.ts)
// rather than in this script: this one stays a plain file reader with no build behind it. A checkout runs the
// TypeScript with Node's type stripping; an installed package runs the built file. Neither is present in a package
// older than this feature, which is why the last branch explains instead of failing with a stack.
if (args.includes("--cost") || args.some((arg) => arg === "--by" || arg.startsWith("--by="))) {
	const here = dirname(fileURLToPath(import.meta.url));
	const candidates = [
		[join(here, "..", "..", "packages", "kyrn-judge", "src", "ledger", "cli.ts"), ["--experimental-strip-types"]],
		[join(here, "..", "..", "judge", "dist", "ledger", "cli.js"), []],
		[join(here, "..", "..", "dist", "ledger", "cli.js"), []],
	];
	const found = candidates.find(([path]) => existsSync(path));
	if (!found) {
		console.error("mu ledger: the cost view is not in this build. `mu ledger --json` still lists every decision with its usage.");
		process.exit(1);
	}
	const run = spawnSync(process.execPath, [...found[1], found[0], ...args], { stdio: "inherit" });
	process.exit(run.status ?? 1);
}
const asJson = args.includes("--json");
const limit = Number(args.find((arg) => /^\d+$/.test(arg)) ?? 5);
/** `SPEC_AI_JEV_<name>`; no earlier spelling is read. */
const env = (name) => process.env[`SPEC_AI_JEV_${name}`];
const agentDir = env("AGENT_DIR") ?? process.env.PI_CODING_AGENT_DIR ?? join(homedir(), ".spec.ai.jev", "agent");
const sessionsDir = env("SESSIONS_DIR") ?? join(agentDir, "sessions");

function sessionFiles(dir) {
	let found = [];
	let entries = [];
	try {
		entries = readdirSync(dir, { withFileTypes: true });
	} catch {
		return found;
	}
	for (const entry of entries) {
		const path = join(dir, entry.name);
		if (entry.isDirectory()) found = found.concat(sessionFiles(path));
		else if (entry.name.endsWith(".jsonl")) found.push({ path, mtime: statSync(path).mtimeMs });
	}
	return found;
}

function textOf(content) {
	if (typeof content === "string") return content;
	if (!Array.isArray(content)) return "";
	return content
		.filter((block) => block?.type === "text" && typeof block.text === "string")
		.map((block) => block.text)
		.join("\n");
}

const files = sessionFiles(sessionsDir)
	.sort((a, b) => b.mtime - a.mtime)
	.slice(0, limit)
	.reverse();

let count = 0;
for (const file of files) {
	let lastUserMessage = "";
	for (const line of readFileSync(file.path, "utf8").split("\n")) {
		if (!line.trim()) continue;
		let entry;
		try {
			entry = JSON.parse(line);
		} catch {
			continue;
		}
		if (entry.type === "message" && entry.message?.role === "user") lastUserMessage = textOf(entry.message.content);
		if (entry.type !== "custom" || entry.customType !== "kyrn.decision") continue;

		const record = entry.data ?? {};
		count++;
		if (asJson) {
			console.log(JSON.stringify({ session: file.path, userMessage: lastUserMessage, ...record }));
			continue;
		}
		const judged = record.judged;
		const timing = record.latencyMs === undefined ? "" : ` ${record.latencyMs}ms`;
		const when = record.timestamp ? new Date(record.timestamp).toLocaleString("sv-SE").slice(0, 16) : "";
		const head = `${when}  [${record.providerId} ${record.mode} v${record.specVersion}${timing}]`;
		const verdict =
			judged && typeof judged === "object" && "turnType" in judged
				? `${judged.turnType} -> ${judged.gear}  files=${judged.needsFilesChanged} side=${judged.sideQuestion} clarify=${judged.needsClarification} memory=${judged.needsMemory} swarm=${judged.swarmWorthy} plan=${judged.planFirst}`
				: judged === undefined
					? `no verdict (${record.reason ?? "unknown"})`
					: JSON.stringify(judged);
		console.log(`${head}  ${record.specId}: ${verdict}`);
		console.log(`    "${lastUserMessage.replace(/\s+/g, " ").slice(0, 160)}"`);
		for (const warning of record.warnings ?? []) console.log(`    ! ${warning.type} ${warning.questionId ?? ""}`);
	}
}

if (!asJson) console.log(count === 0 ? `No decisions found under ${sessionsDir}` : `\n${count} decisions from ${files.length} sessions`);
