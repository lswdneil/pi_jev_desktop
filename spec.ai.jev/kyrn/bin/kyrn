#!/usr/bin/env bash
# This is the kernel's old command name; it runs the same launcher as `spec`.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
exec "$(cd -P "$(dirname "$SOURCE")" && pwd)/spec" "$@"
