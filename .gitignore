# The build output: `out/main`, `out/preload`, `out/renderer`.
out/
node_modules/
.vite/
playwright-report/
test-results/
*.log

# Where `npm run metrics` and `npm run render-probes` write the numbers they measured; they depend on the machine, so the
# record of them lives in docs/performance-budget.md rather than in a file that would be stale the moment another machine
# ran it.
shell-metrics.json
render-probes.json

# The packaged mu runtime, staged by `npm run stage:harness`. It is a built package of ~34 MB, not source; the release
# pipeline stages it from a mu build, and a checkout stays without it.
resources/harness/mu-agent/

# Installer output.
dist/

# The vendored runtime source tree. Its dependencies and build output are rebuilt, never committed; the harness the app
# ships is staged into resources/harness (also ignored).
spec.ai.jev/**/node_modules/
spec.ai.jev/.artifacts/
spec.ai.jev/.tmp/
spec.ai.jev/**/dist/
spec.ai.jev/**/out/
spec.ai.jev/**/coverage/
spec.ai.jev/**/test-results/
spec.ai.jev/**/playwright-report/
