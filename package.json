{
  "name": "spec.ai.jev",
  "version": "0.1.0",
  "description": "spec.ai.jev: a judgment-native desktop workspace for coding agents",
  "private": true,
  "license": "MIT",
  "author": "the spec.ai.jev authors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "verify": "npm run typecheck && npm test && npm run build && npm run budget",
    "stage:harness": "node scripts/stage-harness.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest --run",
    "test:e2e": "playwright test test/e2e",
    "budget": "node scripts/desktop-budget.mjs --check",
    "budget:update": "node scripts/desktop-budget.mjs --update",
    "package": "npm run build && npm run stage:harness && electron-builder --publish never",
    "package:dir": "npm run build && npm run stage:harness && electron-builder --dir --publish never",
    "smoke:package": "node scripts/smoke-package.mjs",
    "install:rehearsal": "node scripts/install-rehearsal.mjs",
    "startup": "node scripts/startup.mjs",
    "metrics": "node scripts/collect-metrics.mjs",
    "render-probes": "node scripts/render-probes.mjs",
    "prototype:screenshot": "electron scripts/screenshot-prototype.cjs",
    "startup:update": "node scripts/startup.mjs --update"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.30",
    "@assistant-ui/react": "0.15.30",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.59.0",
    "react-resizable-panels": "4.14.7",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  }
}
